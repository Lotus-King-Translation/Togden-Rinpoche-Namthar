msgctxt "f695c00393eb4a5080632876ff9e1446"
msgid "༨་␣༽  སྲིད་ ཀྱི་ ཐོག་ ནས་ ཞབས་འདེགས་ ཞུས་ ཚུལ །  ༡༡"
msgstr ""

msgctxt "a6a05fbd57ea44b5a6d15457ed94f076"
msgid "༩་␣༽  མཛད་པ་ མཐའ་མ་ ཞི་བ་␣ར་ གཤེགས་པ །  ༡༡"
msgstr ""

msgctxt "bfe943ca0469491193f15255d1eebc9e"
msgid "༡༠་␣༽  མྱུར་ བྱོན་ གསོལ་འདེབས་ རྡོ་རྗེ་ འཆང་ དབང་མ །  ༡༣"
msgstr ""

msgctxt "e13f0e1aefdb45d5bffa029075c886a9"
msgid "༡༡་␣༽  མྱུར་ བྱོན་ གསོལ་འདེབས་ ཁམས་ གསུམ་ འགྲོ་བ་ མ །  ༡༤"
