ང་དྲུང་ དགོན་ གྱི་ དགེ་འདུན་ རྣམས་ ལ་ འབྲི་གུང་ རྒྱུད་སྡེ་ རྣམས་ ཀྱི་ དབང་ །_ ཆོས་སྲུང་ ཡོངས་རྫོགས་ ཀྱི་ དབང་ །_ རྒྱལ་དབང་ རིན་ཆེན་ ཕུན་ཚོགས་ ཀྱི་ དགོངས་གཏེར །_ ཡང་ ཟབ་ཞི་ ཁྲོ འི་ དབང་ཆེན །_ ཤོག་བུ་ རིགས་ དྲུག་ ཀྱི་ དབང་ །_ གཡུང་དྲུང་ དགོན་ དང་ ཆུ་ཤུལ་ དགོན་ དུ་ རྒྱལ་བ འི་ བཀའ་འགྱུར་ རིན་པོ་ཆེ འི་ ལུང་ དག་ ཐོན་ ཚར་ གཉིས །_ གླེ་ ཇོ་ཁང་ དུ་ རིན་ཆེན་ གཏེར་མཛོད་ ཀྱི་ དབང་ལུང་ །_ ལ་དྭགས་ ཀྱི་ ཡུལ་གྲུ་ ཁག་ ཕལ་ཆེ་བ ར་ མ་ཎི་ དང་ བཛྲ་ གུ་རུ འི་ དབང་ལུང་ མ་ གནང་བ་ གཅིག་ ཀྱང་ ལྷག་མེད །ཆོས་རྗེ འི་ ཚུལ་ དུ་ ཞབས་འདེགས་ ཞུས་པ །དེ་ཡང་ ལ་དྭགས་ སུ་ ༸ཆོས་ རྗེ་ དང་པོ་ གདན་ མ་ ཀུན་དགའ་ གྲགས་པ་ དཔལ་ བཟང་པོ་ མཆོག་ ནས་ཞིང་ གཤེགས་ དམ་པ་ ༸སྐྱབས་ རྗེ་ ལ་དྭགས་ ཆོས་རྗེ་ རྟོགས་ལྡན་ རིན་པོ་ཆེ་ མཚན་ སྨོས་པ ར་ དཀའ་བ་ དཀོན་མཆོག་ ཐུབ་བསྟན་ བསྟན་པ འི་ རྒྱལ་མཚན་ དཔལ་ བཟང་པོ་ མཆོག་ བར་ ཆོས་རྗེ་ སོ་ གསུམ་ བྱུང་ ཡོད །༸སྐྱབས་ མགོན་ རྡོ་རྗེ་ འཆང་ ཞི་བ འི་ བློ་གྲོས་ ཀྱིས་ མེ་ ཁྱི་ལོ་ བོད་ཟླ་_ ༡༠_ ཚེས་ ༡༠_ སྤྱི་ལོ་_ ༡༩༤༥_ ནས་ སྐུ་ མ་ གཤེགས་ བར་ དུ་ ལ་དྭགས་ ཆོས་རྗེ འི་ ཚུལ་ དུ་ དགོན་ ཁག་ ཆེ་ འབྲིང་ ཆུང་ གསུམ་ ཚང་མ་ ལ་ གང་ཅི འི་ ཐོག་ ནས་ ཞིག་གསོ ས་ དང་ ཡར་ རྒྱས་ མཛད་པ་ ནི་ ཚང་མ ས་ མཁྱེན་ གསལ་ ལྟར་ ཡིན །བླ་མ་ ཁྱེད་ ཀྱི་ བཀའ་དྲིན་ ནི་ རང་ རེ་ ལ་དྭགས་པ་ ཡོངས་ དང་ ཡང་སྒོས་ སུ་ རྒྱལ་བ་ འབྲི་གུང་པ འི་ དགོན་ ཁག་ གསུམ་ གཙོ ས་ དད་ ལྡན་ ཡོངས་ ལ་ ཕ་མ་ དང་ ཉི་ཟླ་ ལྟ་བུ ར་ བཀའ་དྲིན་ ཤིན་ཏུ་ ཆེ འོ །_།དག་སྣང་ བྱུང་ཚུལ་ དང་ གནས་ སྒོ་ ཕྱེས་ ཚུལ །༸སྐྱབས་ རྗེ་ རིན་པོ་ཆེ་ ནི་ ཨོ་རྒྱན་ གྱི་ སློབ་དཔོན་ ཆེན་པོ་ ལ་ དད་པ་ དང་ ཡིད་ཆེས་ གཡོ་བ་ མེད་པ ར་ བརྟེན་ བོད་ དུ་ གཏེར་ སྒྲོམ་ མཇལ་ སྐབས་ འདུ་ཁང་ གི་ མཐིལ་ རྡོ འི་ སྟེང་ ནས་ གནས་ཆེན་ ཕྱོགས་ ལ་ མཇལ་ སྐབས་ གཏེར་ སྒྲོམ་ གནས་རི་ རྡོ་རྗེ་ ལྷོ་ཁ འི་ བྲག་ཕུག་ ཏུ་ དད་པ་ དང་ མོས་གུས་ དཔག་མེད་ འཁྲུངས །སངས་རྒྱས་ གཉིས་པ་ ཨོ་རྒྱན་ རིན་པོ་ཆེ་ བོད་ ལ་ བཀའ་དྲིན་ ཆེ་བ་ ཡིན་པ ས་ ཐུགས་རྒྱུད་ ལ་ དགའ་བ་ བརྟས །_ རྒྱ་གར་ ཕཎ་ ཆེན་ བོད་ ལ་ བཀའ་དྲིན་ ཆེ །_། ཞེས་པ འི་ ཤློཀ་ འདོན་ བཞིན་ སྣང་བ་ གཡེངས་ དུས་ རྡོ་རྗེ་ ལྷོ་ཁ འི་ བྲག་ ངོས་ ནས་ མཁའ་འགྲོ་ མ་ གཉིས་ ཀྱིས་ དར་དཀར་ གྱི་ ཡོལ་བ་ ཕྱེས་ ནས་ གུ་རུ་ རིན་པོ་ཆེ་ མཇལ་བ འི་ མོད་ ལ་ ཞལ་ དམ་ དང་ ཟངས་མདོག་ དཔལ་ རི འི་ སྨོན་ལམ་ དང་ རྟོགས་ལྡན་ རིན་པོ་ཆེ འི་ སྐྱེ་བ འི་ རྣམ་ གྲངས་ རྣམས་ གསུངས་པ འི་ དག་སྣང་ བྱུང་ །རྡོ འི་ སྟེང་ དུ་ ཞབས་ གཉིས་ ཀྱི་ རྗེས་ སྐུ་ པུས་ ནུབ་ ཙམ་་ བྱུང་ ཡོད་པ་ ནི་ གཏེར་ སྒྲོམ་ དགོན་ མཇལ་ དུ་ ཕེབས་པ་ རྣམས་ ཀྱིས་ དངོས་ སུ་ མཇལ་ མྱོང་ ཡོད །དེ་ནས་ ལ་ ལོག་ རྡོར་ ཁུལ་ ཡུལ་ གྱི་ ནུབ་བྱང་ དུ་ གནས་ཆེན་ དར་ སེང་དཀར་ མོ་ ཞེས་པ་ ལྷ་ཆེན་ བྲག་ ལྷ་དབང་ ཕྱུག་ གཉིས་ ནས་ གནས་ སྒོ་ ཕྱེས་པ ར་ མཛད །རྒྱས་པ་ གནས་ཡིག་ ནང་གསལ་ བས་ དེ ར་ གཟིགས །ཕུ་ དཀ ར་ ཨོ་རྒྱན་ རྫོང་ དུ་ ཡང་ སེམས་ཅན་ མ་ གྲོལ་བ་ རྣམས་ འགྲོལ་བ འི་ ཆེད་ ཨོ་རྒྱན་ རིན་པོ་ཆེ་ དང་ ཞལ་མཇལ་ ནས་ གནས་ སྒོ་ ཕྱེས་ ཡོད་པ་ རྒྱས་པ ར་ གནས་ཡིག་ ཏུ་ གསལ །གཞན་ ཡང་ ལ་དྭགས་ ཀྱི་ ཡུལ་ལུང་ མང་པོ ར་ གནས་ སྒོ་ཚད་ མེད་ ཕྱེས་ ཡོད །རོང་ ཆོས་ རྒྱུད་ ཀྱི་ ཡུལ་ དར་ སྐྱིད་ ཞེས་ པར་སྤྱི་ ལོ་_ ༢༠༠༦_ ཙམ་ ནང་ གནས་ སྒོ་ ཕྱེས་པ ར་ མཛད་ ནས་ གནས་ཡིག་ དག་སྣང་ ཆུ་ཟླ འི་ མེ་ལོང་ ཞེས་ བྱ་བ་ བརྩམས་ ཡོད་པ ར་ དེ ར་ གཟིགས་པ ར་ ཞུ །ཕྱག་ རྗེས་ དང་ ཞབས་རྗེས་ ནི་ དགོན་པ་ ཁག་ གི་ མཆོད་ཆས་ དང་ མཆོད་རྫས་ མང་པོ ར་ འཁྲུངས་ ཡོད་པ་ གྲངས་ ཀྱིས་ མི་ ལང་ ངོ་ །། གཡུང་དྲུང་ གསུམ་ མདོ ར་ ཡོད་པ འི་ ཟངས་མདོག་ དཔལ་ རི ར་ དམ་ཅན་ གྱི་ ར་ རང་བྱོན་ དང་ །_ ཨ་ཕྱི འི་ མེ་ལོང་ བཅས་ གསལ་བ ར་ མཇལ་ རྒྱུ་ ཡོད །ས་ ཕུད་ ཨོ་རྒྱན་ རྫོང་ གི་ ཕོ་བྲང་ གི་ བྲག་ ངོས་ སུ་ བྷྲུཾ་ རང་བྱོན་ ཡོད །ལ་དྭགས་ གཡུང་དྲུང་ ཨ་ ཏི་ རྩེ་ དགོན་ གྱི་ ཆུ་མིག་ ཡན་ལག་ བརྒྱད་ ལྡན་ གྱི་ ཆུ་གཏེར་ སྔོན་ གནས་ ནས་ བརྟོལ་བ ར་ མཛད་ ནས་ཆུ་ གཙང་ དྭངས་མ་ ཐོན་ བཞིན་པ་ དང་ །ཧ་ ནུ་ ཐང་ དུ་ཡོད་པ འི་ བྲག་རི་ ནས་ རྦབ་རྡོ་ བབས་ ཏེ་ འཇིགས་སྣང་ ཅན་ གྱི་ སྐོར་ ཕྱི་ ནང་ ཡུལ་མི་ ཚང་མ ས་ ཞུས་པ ར་ བཞད་ བགད་ ཀྱི་ ཚུལ་ དུ་ ད་ ནས་ ཕྱིན་ཆད་ མ་ ཡོང་ གསུངས་པ ས་ ད་བར་ རྦབ་རྡོ འི་ འཇིགས་པ་ མེད་པ་ ནང་པ་ ཙམ་ མ་ཟད་ ཕྱི་པ འི་ ཆོས་བརྒྱུད་པ་ རྣམས་ ཀྱང་ ཧ་ལ ས་ ནས་ དད་པ ར་ གྱུར །དེ་ལྟར་ ཆུ་ དཀོན་པ འི་ གནས་ སུ་ ཕེབས་ ན་ ཆུ་ དཀོན་ ཞི་བ་ དང་ །ལྷ་འདྲེ་ གདུག་པ་ ཅན་ གནས་པ འི་ ཕྱོགས་ སུ་ ཕེབས་ ན་ རང་ས ར་ ཞི་བ་ དང་ དབང་ དུ་ འདུ་བ ར་ མཛད །མདོར་ན་ ལྷ་འདྲེ་ མི་ གསུམ་ དབང་ དུ་ འདུ་བ འི་ གཏེར་ བཏོན་ ཆེན་པོ་ གང་དེ་ ཝཾ་ མད འི་ དཔའ་བོ་ བློན་པོ ས་ སྤྱན་ གསུམ་པ འི་ བླ་མ་ ཞེས་ དད་པ་ དང་ དམ་ཚིག་ དབྱེ ར་ མེད་པ ར་ མོས་གུས་ བྱེད་པ་ བཞིན་ དོན་ ལ་ ཡང་ གནས་ སོ །_།སྲིད་ ཀྱི་ ཐོག་ ནས་ ཞབས་འདེགས་ ཞུས་ ཚུལ །རྒྱལ་ ཁག་ ཇམྨུ་ ཀཤྨིར་ གཞུང་ དུ་ ལ་དྭགས