རིན་པོ་ཆེ་ ཉིད་ སྐུ་ འཁྲུངས་པ་ དང་ རྟོགས་ལྡན་ རིན་པོ་ཆེ་ སྐུ་ གོང་མ འི་་ ཡང་སྲིད་ ངོས་འཛིན་ དང་ ཁྲི་ སྟོན་ མཛད་ ཚུལ །༄༅།_། བོད་ ཆོས་ལྡན་ གྱི་ ཞིང་ གི་ ཀོང་པོ འི་ ཡུལ་ དུ་ འཁྲུངས་པ འི་ སྐུ འི་ སྐྱེ་བ་ དང་པོ་ རྟོགས་ལྡན་ ཕུན་ཚོགས་ དར་རྒྱས་ ནི་ རྒྱལ་དབང་ རིན་ཆེན་ ཕུན་ཚོགས་ ཀྱིས་ རྗེས་སུ་ བཟུང་བ འི་ སློབ་མ་ འབྲི་གུང་པ འི་ བསྟན་པ འི་ སྒོར་ བཞུགས་ ནས་རྒྱལ་དབང་ རཏྣ་ ལ ས་ ཟབ་ ཆོས་ ཐམས་ཅད་ བུམ་པ་ གང་ བྱོའི་ ཚུལ་ དུ་ གསན་ ནས་ ཙ་རི ར་ སྒྲུབ་པ་ ཡུན་རིང་ དུ་ མཛད་པ ས་ རྟོགས་པ འི་ ཡོན་ཏན་ རྒྱ་ཆེན་པོ་ ཐུགས་ ལ་ འཁྲུངས་པ ས་ མཚན་ ཡང་ ཀོང་པོ་ རྟོགས་ལྡན་ ཞེས་ གྲགས་པ་ གང་དེ ས་ དབུ་སྐྲ་ བཏབ་པ་ ལ ས་ མེ་ཏོག་ རྒྱ་མེན་ སྐྱེ་བ་ དང་ །ཕྱག་ མཁར་ ས་ ལ་ བཙུགས་ ནས་ སྡོང་པོ་ སྐྱེ་བ་ སོགས་ གྲུབ་རྟགས་ མངའ་བ་ དང་ །ཀོང་པོ་ ཤར་ ཁ འི་ རི་ཁྲོད་ ཕྱག་ བཏབ་ ཅིང་ ཀོང་ ཕྱོགས་ སུ་ འགྲོ་དོན་ རྒྱ་ཆེན་པོ་ མཛད །སངས་རྒྱས་ གཉིས་པ་ ཨོ་རྒྱན་ པདྨ་ འབྱུང་གནས་ ཀྱི་ སྤྲུལ་པ་ རྒྱལ་དབང་ རིན་ཆེན་ ཕུན་ཚོགས་ ཀྱིས་ ང་ ཡི་ དངོས་སློབ་ འདི་ རྒྱ་གར་ གྱི་ རིག་འཛིན་ ཆེན་པོ་ ཧཱུྃ་ ཀཱ་ ར འི་ རྣམ་ སྤྲུལ་ ཡིན་ ཞེས་ ལུང་བསྟན །སྐུ འི་ སྐྱེ་བ་ གཉིས་པ་ ཀོང་པོ་ འོད་ ཤོད་ བེ་ རིལ་ དུ་ སྐུ་ འཁྲུངས་ ཏེ་ ཞབས་དྲུང་ ཆོས་རྒྱལ་ ཕུན་ཚོགས་ ཀྱི་ ཞབས་ ལ་ གཏུགས་ ནས་ རབ་ཏུ་ བྱུང །མཚན་ རྟོགས་ལྡན་ བཀྲ་ཤིས་ བསོད་ནམས་ ཞེས་ བཏགས་ ཤིང་ མདོ་ཁམས་ རྔོད་ ཨེ་ཝཾ་ རྣམ་རྒྱལ་ དགོན །ཨེ་ཝཾ་ དགོན་པ །_ མདོ་སྔགས་ དགོན་པ་ བཅས་ དགོན་ ཁག་ གསུམ་ གྱི་ དབུ་བླ་ མཛད །ཁམས་ ཕྱོགས་ སུ་ རྒྱལ་བ་ འབྲི་གུང་པ འི་ བསྟན་པ་ ཉི་མ་ ལྟར་ སྤེལ་ ཞིང་ འགྲོ་དོན་ རྒྱ་ཆེན་པོ ར་ མཛད །སྐུ འི་ སྐྱེ་བ་ གསུམ་པ་ རྟོགས་ལྡན་ སྤྲུལ་སྐུ་ རིན་ཆེན་ དབང་ཕྱུག་ རྔོད་ དུ་ སྐུ་ འཁྲུངས །༸སྐྱབས་ མགོན་ དཀོན་མཆོག་ རཏྣ་ དང་ རྗེ་ ཀུན་མཁྱེན་ ཆོས་ ཀྱི་ གྲགས་པ འི་ སློབ་མ ར་ གྱུར་ ཅིང་ ནགས་ ཤོད་ ཆོས་འཁོར་ བྱམས་པ་ གླིང་ གི་ བླ་མ་ མཛད །ནགས་ ཤོད་ དགོན་པ་ ཉམས་གསོ་ དང་ རྟེན་ དང་ བརྟེན་པ ར་ བཅས་ བཞེངས་ ནས་ ཀུན་མཁྱེན་ ཆོས་ ཀྱི་ གྲགས་པ་ གདན་ཞུ ས་ ནས་ བཀྲ་ཤིས་ རབ་གནས་ མཛད །དགེ་འདུན་ བཅུ་ཕྲག་ ལྔ་ ཙམ་ རབ་ཏུ་ བྱུང་ ནས་ འགྲོ་དོན་ རྒྱས་ ཤིང་ མཛད་འཕྲིན་ ཤིན་ཏུ་ བཟང་པོ ར་ བྱུང་ ངོ་ །_།སྐུ འི་ སྐྱེ་བ་ བཞི་པ་ རྟོགས་ལྡན་ སྤྲུལ་སྐུ་ བསྟན་འཛིན་ རྣམ་རྒྱལ་ ཞེས་པ་ བྱང་ རྣམ་ རུར་ སྐུ་ འཁྲུངས་ ནས་ འབྲི་གུང་ གདན་ས ར་ ཕེབས་ ཏེ་༸སྐྱབས་ མགོན་ འཕྲིན་ལས་ བཟང་པོ་ འཕགས་པ་ སྤྱན་རས་ གཟིགས་ དངོས་ ཀྱི་ ཞབས་ ལ་ གཏུགས་ ནས་འབྲི་གུང་ རང་ལུགས་ ཀྱི་ མདོ་སྔགས་ ཀྱི་ ཆོས་ དང་ །_ བསྟན་ སྙིང་ དགོངས་ གཅིག_ སྐྱོབ་པ འི་ ཟབ་ ཆོས །_ གཞན་ ཡང་ བཀའ་འབུམ་ སོགས་ ཀྱི་ ལྗགས་ལུང་ དང །_ བཀའ་ བརྒྱུད་ སྒྲུབ་ ཆོས་ ཀྱི་ དབང །_ མདོ་ མཆོག_ ཀྱཻ་ རྡོར །_ ཀུན་རིག_ གཙུག་ གུ་ སོགས་ རྒྱུད་སྡེ་ རྒྱ་མཚོ འི་ དབང་ལུང་ རྣམས་ གསན་ བསམ་ མཛད །གཞན་ ཡང་ བླ་མ་ མཁས་པ་ དག་ གི་ ཞབས་ ལ་ གཏུགས་ ནས་ རིག་གནས་ དང་ །_ སྙན་ངག_ རྒྱ་ གཞུང་ སོགས་ གསན་ ནས་ མཁས་པ འི་ ཡང་རྩེ ར་ ཕེབས །ཐུབ་བསྟན་ ཡང་ རི་ སྒར་ གྱི་ མཁན་པོ་ མཛད །སྐུ་བསོད་ མངའ་ཐང་ ཤིན་ཏུ་ ཆེ་བ་ བྱུང །འབྲི་གུང་ སྦྲང་ ནང་ ཆོས་སྲིད་ གཞིས་ཀ འི་ རི་རྩེ ར་ སྒྲུབ་ཁང་ པདྨ་ ཡང་རྩེ་ ཕྱག་ བཏབས །བཙུན་མ་ ལྔ་ བཅུ་ ཙམ་ གྱི་ སྡེ་ བཙུགས་ ནས་ ཡང་ ཟབ་ ཀྱི་ སྔོན་འགྲོ འི་ ཉམས་ལེན་ སོགས་ ནས་ ཡི་དམ་ བར་ གྱི་ ལག་ལེན་ དང་ ཁྲིད་ ཁ་ སོགས་ མཛད་ ནས་ བཙུན་ དགོན་ དར་ ཞིང་ རྒྱས་པ ར་ མཛད་ དོ །_།དེ འི་ ཡང་སྲིད་ སྐུ འི་ སྐྱེ་བ་ ལྔ་པ་ རྟོགས་ལྡན་ སྤྲུལ་སྐུ་ ཆོས་ ཀྱི་ བློ་གྲོས་ ཞེས་ བྱ་བ་ དེ་ཡང་ འབྲི་གུང་ མང་ར འི་ ནང་ བསོད་ནམས་ བག་ དྲོ་ ཞེས་པ འི་ ཁྱིམ་ དུ་ སྐུ་ འཁྲུངས །༸སྐྱབས་ མགོན་ དོན་གྲུབ་ ཆོས་རྒྱལ་ དང །_ བསྟན་འཛིན་ འགྲོ་ འདུལ་ གཉིས་ ཀྱི་ སློབ་མ ར་ གྱུར་ ཅིང་ སྙེ་མོ་ མཐོང་ སྨོན་ ཤེལ་དཀར་ སྒྲུབ་ སྡེ འི་ བླ་མ་ མཛད་ ནས་ དགུང་ལོ་ ཉི་ཤུ འི་ སྐོར་ ལ་ བྱང་ དུ་ སྐུ་གཤེགས །སྐུ འི་ སྐྱེ་བ་ དྲུག་པ་ རྟོགས་ལྡན་ སྤྲུལ་སྐུ་ བསྟན་འཛིན་ ཆོས་གྲགས་ ནི་ དབུར་སྟོད་ སྦྲང་ ཕུར་ སྦྲང་ སྤྱན་ ཤར་པ་ ཞེས་པ འི་ ཁྱིམ་ དུ་ སྐུ་ འཁྲུངས །༸སྐྱབས་ མགོན་ ཆོས་ ཀྱི་ ཉི་མ་ ལ་ གཙུག་ཕུད་ ཕུལ་ ཞིང་༸སྐྱབས་ མགོན་ པདྨ འི་ རྒྱལ་མཚན་ དྲུང་ དུ་ རབ་ཏུ་ བྱུང་ ཞིང་ བསྙེན་པ ར་ རྫོགས་པ་ ནས་ འབྲི་གུང་ གི་ དབང་ལུང་ དཔེ་ཁྲིད་ ཡོངས་རྫོགས་ གསན །འབྲི་གུང་ ནས་ གཙང་ རྟའུ་ ཤག་ རམ་ དང་ །_ མངའ་རིས་ དགོན་ ཁག་ སྒང་ སྔོན་ བཀྲ་ཤིས་ ཆོས་རྫོང་ །_ གཡུང་དྲུང་ ཐར་པ་ གླིང །_ ཤང་ ཨེ་ཝཾ་ དགོན་ སོགས་ ཀྱི་ ཆོས་རྗེ ར་ བསྐོ་གཞག་་ མཛད །ལ་དྭགས་ རྒྱལ་པོ་ ཚེ་དབང་ རྣམ་རྒྱལ་ དང་ རྒྱལ་པོ་ ཚེ་བརྟན་ རྣམ་རྒྱལ་ རྣམ་ གཉིས་ ཀྱི་ དབུ་བླ་ མཛད །དེ་ནས་ བོད་ དུ་ ཕེབས་ ཏེ་ ཡང་ རི་ སྒར་ གྱི་ མཁན་པོ་ མཛད །སྐུ་ ཤིན་ཏུ་ བཙུན་ ཞིང་ ཐུགས་དམ་ འཕེལ་བ ར་ གྲགས་ ཤིང་ ༸རྗེ་ པདྨ འི་ རྒྱལ་མཚན་ གྱིས་ ཐུགས་མཉེས་པོ་ མཛད་པ་ དང་ ༸སྐྱབས་ མགོན་ རྣམ་ གཉིས་ ཞི་བ ར་ གཤེགས་ སྐབས་ ཡང་ རི་ སྒར་ གྱི་ བཀའ་ བརྒྱད་ སྒྲུབ་ ཆེན་ གྱི་ རྡོར་ སློབ་ མཛད་པ་ དང་ །འབྲི་ མཐིལ་ དུ་ གསེར་གདུང་ སྒྲུབ་ སྐབས་ རབ་གནས་ ཀྱི་ རྡོ་རྗེ་ སློབ་དཔོན་ མཛད་པ་ སོགས་ དེ་དུས་ ཀྱི་ བུ་སློབ་ ཀུན་ གྱི་ གཙོ་བོ ར་ གྱུར །སྐུ་ཚེ་ ཡང་ རིང་པོ ར་ བཞུགས་ སོ །སྐུ འི་ སྐྱེ་བ་ བདུན་པ་ རྟོགས་ལྡན་ སྤྲུལ་སྐུ་ ངག་དབང་ དགེ་ལེགས་ དབང་ཕྱུག་ ནི །དབུར་སྟོད་ ཀྱི་ དོན་ གད་ ཀྱི་ ཕུར་ སྐུ་ འཁྲུངས །༸རྗེ་ ཆོས་ཉིད་ ནོར་བུ་ ལ ས་ རབ་ཏུ་ བྱུང་ ཞིང་ བསྙེན་པ ར་ རྫོགས །ལ་དྭགས་ མངའ་རིས་ སྒང་ སྔོན་ དགོན་ གྱི་ ཆོས་རྗེ་ མཛད་ ཅིང་ ལ་དྭགས་ ཆོས་རྒྱལ་ ཀུན་དགའ་ རྣམ་རྒྱལ་ དང་ མཆོད་ཡོན་ དུ་ འབྲེལ །མངའ་རིས་ སུ་ འཕྲིན་ལས་ ཆེ་བ ར་ གྱུར་ ཀྱང་ དགུང་ལོ་ ཉེར་ ལྔ་ ལ་ རྒྱ་གར་ དུ་ ཕེབས་པ འི་ ལམ་ དུ་ མཚོ་ པདྨ ར་ ཚད་པ ས་ རྐྱེན་ བྱས་ ནས་ སྐུ་གཤེགས །འདྲ་སྐུ་ གཡུང་དྲུང་ དགོན་ གྱི་ གཟིམ་ཆུང་ དབུས་ དང་ ཤང་ དགོན་ རྙིང་པ འི་ ཚོགས་ཁང་ ནང་ དུའང་ བཞུགས །སྐུ་ཕྲེང་ བརྒྱད་པ་ སྐུ་ན་ ཆུང་ དུས་ སུ་ མཚན་ རྟོགས་ལྡན་ སྤྲུལ་སྐུ་ བློ་གྲོས་ རྒྱལ་མཚན །ལ་དྭགས་ རྒྱལ་པོ་ ཀུན་དགའ་ རྣམ་རྒྱལ་ གྱི་ སྲས་ སུ་ ཏོག་ དགུ་པོ་པ་ ཞེས་པ འི་ ཁྱིམ་ དུ་ འཁྲུངས །དགེ་རྒན་ ཚེ་རིང་ དོན་གྲུབ་ བསྟེན་ ནས་ ཡི་གེ་ འབྲི་ ཀློག་ ནས་ འདོན་ ཆོས་སྤྱོད་ སོགས་ ལེགས་པ ར་ སྦྱང་བརྩོན་ མཛད་ ནས་ བོད་ དུ་ ཕེབས །༸སྐྱབས་ མགོན་ ཐུགས་རྗེ་ ཉི་མ་ ལ ས་ རབ་ཏུ་ བྱུང་ སྟེ་ མཚན་ དཀོན་མཆོག་ བསྟན་འཛིན་ དམ་ཆོས་ འགྱུར་མེད་ ཅེས་ གསོལ །བསྙེན་རྫོགས་ ཀྱང་ བསྒྲུབས་ ནས་ སོ་ཐར་ གྱི་ དགོངས་ དོན་ བཞིན་ འདུལ་ཁྲིམས་ མིག་འབྲས་ བཞིན་ བསྲུངས་པ་ དང་ །༸སྐྱབས་ མགོན་ ཆུང་ ཚང་ ཆོས་ ཀྱི་ བློ་གྲོས་ ལ ས་ འབྲི་ ལུགས་ ཀྱི་ དབང་ལུང་ ཇི་སྙེད་པ་ ཞུས་ ཤིང་ དད་གུས་ དང་ ཞབས་ཏོག་ ཤིན་ཏུ་ ཆེ་བ་ ཞུས །༸སྐྱབས་ མགོན་ ཆེ་ ཚང་ ཞི་བ འི་ བློ་གྲོས་ ཀྱང་ ལ་དྭགས་ ལ་ གདན་འདྲེན་ ཕྱིར་ ཞུ་བ་ ཡང་ན ས་ ཡང་ དུ་ ཕུལ་ ཡང་ བོད་ སྡེ་པ་ གཞུང་ ནས་ གངས་ རིན་པོ་ཆེ་ བར་མ་ གཏོགས་ ཕེབས་ མི་ ཆོག་ ཟེར་ ནས་ དགོངས་པ་ མ་ གནང་ བས་ ཆོས་རྗེ་ ཉིད་ བློ་ ཤིན་ཏུ་ ཕམ །གངས་ རིན་པོ་ཆེ ར་ ཕེབས་ ནས་ ༸སྐྱབས་ མགོན་ རྡོ་རྗེ་ འཆང་ ཆེན་པོ ར་ མཎྜལ་ སྐུ་གསུང་ཐུགས་ རྟེན་ དང་ འབུལ་བ་ རྒྱ་ཆེན་པོ་ ཕུལ་ ནས་ མ་འོངས་པ་ ན་ ལ་དྭགས་ ལ་ ཞབས་ སོ ར་ འཁོད་པ འི་ སྨོན་ འདུན་ མཛད །༸སྐྱབས་ མགོན་ མཆོག་ ནས་ སྐུ་ཚེ་ ནམ་ འཚོ འི་ བར་ དུ་ ལ་དྭགས་ ལ་ བསྟན་ དོན་ སྤེལ་ ཕྱིར་ ཆོས་རྗེ་ མཛད་ དགོས་པ འི་ ཕྱག་དམ་ གནང །ལ་དྭགས་ དགོན་ ཁག་ 