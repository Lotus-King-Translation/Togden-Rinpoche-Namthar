 རྗེས་སུ་པ ར་ བསྐྲུན་ བྱ་ རྒྱུ འི་ རེ་བ་ དང་ བཅས་ འདི འི་ ནང་ནོར་ འཁྲུལ་ ཡོད་ ཤས་ ཆེ་བ ས་ རྗེས་སུ་ བཅོས་བསྒྱུར་ བྱ་ རྒྱུ་ བཅས་ འདི ས་ ཀྱང་ བླ་མ་ དམ་པ་ གང་ གི་ སློབ་མ་ ཐ་ཤལ་བ འི་ ཚུལ་ དུ་ ཞབས་འདེགས་ ཞུ་ ནུས་ མེད་ ཀྱང་ ཡང་སྲིད་ མྱུར་ དུ་ འབྱོན་ ནས་ མཇལ་བ འི་ བསོད་ནམས་ དང་ ལྡན་པ འི་ རྒྱུ ར་ འགྱུར་ ཅིག །།_།མྱུར་ བྱོན་ གསོལ་འདེབས །༄༅།_། རྡོ་རྗེ་ འཆང་ དབང་ ཏཻ་ ལོ་ ནཱ་ རོ་ དང་ །། མར་ མི་ དྭགས་པོ་ ཕག་གྲུ་ འཇིག་རྟེན་ མགོན །། གདན་རབས་ གསེར་ གྱི་ ཕྲེང་བ འི་ བྱིན་རླབས་ ཀྱིས །། དེང་ འདི ར་ སྨོན་པ འི་ འབྲས་བུ ར་ བདེན་ བྱིན་ སྩོལ །། དཀོན་མཆོག་ གསུམ་ གྱི་ བསྟན་པ་ འཛིན་པ་ ལ །། དཀའ་སྤྱད་ སྙིང་རུས་ བོད་ དུ་ ཆོས་ ཞུགས་ མཛད །། འབྲི་གུང་ ཉི་ ལྕང་ བཤད་ གྲྭར་ ཐོས་བསམ་ ཀྱིས །། མཁས་པ འི་ དབང་པོ ར་ སོན་ དེ ར་ གུས་པ ས་ འདུད །། ཐུབ་བསྟན་ སྤྱི་ དང་ ༸རྒྱལ་ བའ་ འབྲི་གུང་པ འི །། བཤད་སྒྲུབ་ ལ ས་ གསུམ་ ཆོས་སྲིད་ བཟུང་ འབྲེལ་ གྱིས །། ཐབས་མཁས་ བསྟན་པ་ སྐྱོང་ ལ་ ཆེས་ དཔའ་བ །། ལ་དྭགས་ ཆོས་རྗེ འི་ ཞབས་ ལ་ གསོལ་བ་ འདེབས །། རྡོ་རྗེ འི་ ཁམས་ ལ་ གཞོམ་ ཞིག་ དང་ བྲལ་ ཡང་ །། རེ་ཞིག་ འདུལ་ བྱ ར་ མི་རྟག་ སྟོན་པ འི་ ཕྱིར །། ཞིང་ གཞན་ གཤེགས་པ འི་ ངང་ཚུལ་ སྟོན་ ན འང་ །། ཐུགས་བསྐྱེད་ དབང་ གིས་ ཡང་སྤྲུལ་ མྱུར་ བྱོན་ མཛོད །། མཆོག་ གསུམ་ བསླུ་མེད་ ཨ་ཕྱི་ ཆོས་ ཀྱི་ སྒྲོན །། རྟེན་འབྲེལ་ བསླུ་བ་ མེད་པ འི་ བདེན་པ་ དང །། བསྟན་པ འི་ རྒྱལ་མཚན་ སྲིད་མཐ ར་ བསྒྲེངས་པ འི་ ཕྱིར །། འཁྲུལ་ བྲལ་ ཡང་སྲིད་ མྱུར་ དུ་ བྱོན་ མཛད་ གསོལ །_།ཞེས་པ་ ཡང་སྲིད་ སྲི་ཞུ་ ལྷན་ ཚོགས་ ནས་ བསྐུལ་བ འི་ ངོ ར་ ། ༸རྒྱལ་བ་ འབྲི་གུང་པ འི་ མཚན་ གྱིས་ བྱིན་ གྱིས་ བརླབས་པ ། དཀོན་མཆོག་ བསྟན་འཛིན་ ཀུན་བཟང་ ཕྲིན་ལས་ ལྷུན་གྲུབ་ ཀྱིས་ དྭང་བ འི་ བློ ས ། རབ་གནས་ ཆུ་ ཡོས་ ༢༠༢༣ ལོ འི་ ཟླ་ ༥ ཚེས་ ༢༩ སྔ་དྲོ འི་ ཆ ར་ དགེ འོ །།ན་མོ་ གུ་རུ་ ཡེ །ཁམས་ གསུམ་ འགྲོ་བ འི་ བླ་མ་ ཆོས་ ཀྱི་ རྗེ །། རྟོགས་པ་ མཆོག་ལྡན་ དྲིན་ཅན་ མགོན་ ཁྱེད་ ཉིད །། ཆོས་ ཀྱི་ སྐུ་ ལ་ གཤེགས་ བཞུད་ མི་ མངའ་ ཡང་ །། གཟུགས་སྐུ་ གཤེགས་པ ར་ བདག་ སོགས་ གདུང་བ ས་ མན ར །། བསྐལ་ མང་ གོམ་པ འི་ རླབས་ཆེན་ ཐུགས་བསྐྱེད་ དང་ །། བདག་ཅག་ སློབ་འབངས་ གདུང་བ ས་ མན ར་ གཟིགས་ ནས །། མཆོག་སྤྲུལ་ ཉི་གཞོན་ གསར་པ་ མྱུར་ འཆར་ ནས །། མཛད་འཕྲིན་ ཕྱོགས་མཐ ར་ ཁྱབ་པ་ ཉིད་ གྱུར་ཅིག །།ཏཱ་ར་ གསང་ ཆེན་ སྒྲུབ་ སྡེ ར་ རྨོངས་རྒན་ རཏྣས་ གདུངས་ བས་ གསོལ་བ་ བཏབ་བོ །།༄༅།_། ཞིང་གཤེགས་ དམ་པ་ ལ་དྭགས་ ༸ཆོས་ རྗེ་ རྟོགས་ལྡན་ རིན་པོ་ཆེ་ དཀོན་མཆོག་ བསྟན་འཛིན་ ཐུབ་བསྟན་ བསྟན་པ འི་ རྒྱལ་མཚན་ དཔལ་ བཟང་པོ་ མཆོག་ གི་ མཛད་ རྣམ་ སྙིང་ བསྡུས་ དང་ ཡང་སྲིད་ མྱུར་ བྱོན་ གསོལ་འདེབས་ བཅས་ བཞུགས་ སོ །པར་སྐྲུན་ བྱེད་པོ །ཡང་སྲིད་ སྲི་ཞུ་ ལྷན་ ཚོགས །ཕྱོགས་ བསྒྲིགས་ བྱེད་པོ །_ རིག་ མཚོ་ དཀོན་མཆོག་ རྒྱ་མཚོ་ དང་ ཡེ་ཤེས་ བསྟན་འཛིན་ རྐན་ བཞི །སྤྱི་ལོ་ ༢༠༢༣པར་སྐྲུན་ གསལ་ བཤད །དེ་ཡང་ ཞིང་གཤེགས་ དམ་པ་ ༸སྐྱབས་ རྗེ་ ལ་དྭགས་ ཆོས་རྗེ་ རྟོགས་ལྡན་ རིན་པོ་ཆེ་ སྐུ་ཕྲེང་ དགུ་པ་ ༸དཀོན་ མཆོག་ བསྟན་འཛིན་ ཐུབ་བསྟན་ བསྟན་པ འི་ རྒྱལ་མཚན་ མཆོག་ དགོངས་པ་ ཆོས་དབྱིངས་ སུ་ འཐིམས་ ནས་ ཉིན་ཤ ས་ རིང་ ཐུགས་དམ་ ལ་ བཞུགས་ ཡོད །༸རྒྱལ་ དབང་ འབྲི་གུང་པ་ ༸སྐྱབས་ མགོན་ རྡོ་རྗེ་ འཆང་ ཆེན་པོ་ མཆོག་ ནས་ ཡང་སྲིད་ མྱུར་ བྱོན་ གྱི་ གསོལ་འདེབས་ བརྩམས་ གནང་བ་ དེ་ མི་ མང་ ལ་ སྤེལ་ ཕྱིར་ མཛད་ རྣམ་ སྙིང་ བསྡུས་ ཤིག་ མཉམ་ དུ་ ཕྱོགས་ བསྒྲིགས་ བྱ་ དགོས་ ཞེས་ ཡང་སྲིད་ སྲི་ཞུ་ ལྷན་ ཚོགས་ ནས་ བསྐུལ་བ འི་ ངོ ར་ དེབ་ ཆུང་ འདི་ སྐུ་ ཉིད་ ཀྱིས་ བརྩམས་པ འི་ མང་ཡུལ་ ལ་དྭགས་ ཀྱི་ རྒྱལ་རབས་ ཟླ་ སྣང་ གསར་པ འི་ གཤམ་ དུ་ རྩོམ་པ་པོ འི་ རང་ རྣམ་ཀུན་ གསལ་མེ་ ལོང་ ཞེས་པ་ དེ་ དང་ །དགེ་རྒན་ དཀོན་མཆོག་ བསོད་ནམས་ ཀྱི་ རང་ གི་ ཚེ་ གཅིག་ གི་ མྱོང་ མཐོང་ གི་ ལོ་རྒྱུས་ ཕྲན་བུ་ ཞེས་པ་ གླེ འི་ ཤེས་རིག་ སློབ་ སྡེ ས་པ ར་ བསྐྲུན་ བྱས་པ་ དང །སྐུ་ ཉིད་ སྐུ་ འཚོ་ བཞུགས་ སྐབས་ རང་ རྣམ་རྒྱས་པ་ ཞིག་ འབྲི་ དགོས་ ཞེས་ མཁྱེན་ འདོད་ དང་ དད་པ་ དམ་ཚིག་ ཅན་ འག ས་ བསྐུལ་བ འི་ ངོ ར་ ༸སྐྱབས་ རྗེ་ རིན་པོ་ཆེ་ རང་ གིས་ བྲིས་ གནང་ ནས་ རྐན་ བཞི་བ་ ཡེ་ཤེས་ བསྟན་འཛིན་ ཕྱག་ ཏུ་ གློག་ ཀླད་ དུ་ བཀོད་ ཕྱིར་ གནང་ ཡོད་པ་ དེ་ དང་ །གཞན་ ཡང་ གནས་ཡིག་ སོགས་ དང་ བདག་ གིས་ མྱོང་ཚོར་ མི་ ཉུང་བ་ ཞིག་ ཕྱོགས་ བསྒྲིགས་ བྱས་པ་ ཡིན །ད་དུང་ ༸སྐྱབས་ རྗེ་ རྟོགས་ལྡན་ རིན་པོ་ཆེ་ སྐུ་ ཉིད་ ཀྱིས་ འདས་པ འི་ ལོ་ གཉིས་ གསུམ་ ནས་ སྐུ་ རང་ དང་ འབྲེལ་བ་ དམ་པོ་ ཡོད་པ་ དང་ སྐུ་མཆེད་ དང་ གྲྭ་བ་ རྒན་གྲས་ རེ་ ལ་ ཞལ་ཆེམས་ དངོས་ཤུགས་ གང་རུང་ གི་ སྒོ་ ནས་ གནང་ ཡོད་ ཚོད་ འདུག་པ ས་ མི་ རིང་བ ར་ དྲྭ་ རྒྱ་ དང་ དེབ་ སོགས་ ཐབས་ལམ་ སྣ་ཚོགས་ བརྒྱུད་ དད་ ལྡན་ རྣམས་ ཀྱི་ དྲུང་ དུ་ སླེབ་པ འི་ རེ་སྨོན་ དང་ ཕྱིས་ སུ་ མཛད་ རྣམ་རྒྱས་པ་ པ ར་ བསྐྲུན་ བྱེད་ དུས་ མཛད་ རྣམ་ མ་ལུས་པ ར་ འགོད་ ཐུབ་པ འི་ རེ་བ་ དང་ བཅས་ ཕྱོགས་ བསྒྲིགས་ བྱེད་པོ་ དང་ ཡང་སྲིད་ སྲི་ཞུ་ ལྷན་ ཚོགས་ ནས །_ དགེ འོ །_།དཀར་ཆག༡ ༽_ རིན་པོ་ཆེ་ ཉིད་ སྐུ་ འཁྲུངས་པ་ དང་ རྟོགས་ལྡན་ རིན་པོ་ཆེ་ སྐུ་ གོང་མ འི་་ ཡང་སྲིད་ ངོས་འཛིན་ དང་ ཁྲི་ སྟོན་ མཛད་ ཚུལ །_ ༡༢ ༽_ སྤྲུལ་སྐུ ར་ ངོས་འཛིན་ མཛད་ ཚུལ །_ ༥༣ ༽_ བོད་ དུ་ ཆེས་ མཐོ འི་ སློབ་སྦྱོང་ ལ་ ཕེབས་པ་ དང་ ཞར་ དུ་ རྒྱ་གར་ གནས་ཆེན་ ཁག་ ལ་ གནས་ གཟིགས །_ ༦༤ ༽_ བོད་ དུ་ བླ་མ་ བསྟེན་ ནས་ མདོ་སྔགས་ ཀྱི་ གསུང་ཆོས་ ཞུས་ ཚུལ །_ ༧༥ ༽_ བཀའ་དབང་ དང་ བཀའ་ལུང་ གི་ བདུད་རྩི ས་ འགྲོ་ རྣམས་ འཚིམས་པ ར་ མཛད་ ཚུལ །_ ༩༦ ༽_ ཆོས་རྗེ འི་ ཚུལ་ དུ་ ཞབས་འདེགས་ ཞུས་ ཚུལ །_ ༩༧ ༽_ དག་སྣང་ བྱུང་ཚུལ་ དང་ གནས་ སྒོ་ ཕྱེས་ ཚུལ །_ ༡༠༨ ༽_ སྲིད་ ཀྱི་ ཐོག་ ནས་ ཞབས་འདེགས་ ཞུས་ ཚུལ །_ ༡༡༩ ༽_ མཛད་པ་ མཐའ་མ་ ཞི་བ ར་ གཤེགས་པ །_ ༡༡༡༠ ༽_ མྱུར་ བྱོན་ གསོལ་འདེབས་ རྡོ་རྗེ་ འཆང་ དབང་མ །_ ༡༣༡༡ ༽_ མྱུར་ བྱོན་ གསོལ་འདེབས་ ཁམས་ གསུམ་ འགྲོ་བ་ མ །_ ༡༤