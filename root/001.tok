།། ཞེས་ གསུངས་པ་ ལྟར །འཁྲུངས་ མ་ ཐག་ ཡུམ་ དགོངས་པ་ རྫོགས །དེ་དུས་ ར་ གཅིག་ ལ་ རེའུ་ གཅིག་ ཀྱང་ མཉམ་ དུ་ སྐྱེས །ཡུམ་ འདས་པ ས་ ར་མ འི་ འོ་མ་ དེ ས་ རེའུ་ དང་ བུ་ཆུང་ གཉིས་ མཉམ་ དུ་ འཚོ་ ཐུབ་པ་ བྱུང །སྐུ་མདུན་ གྱིས་ རང་ རྣམ་ གསུངས་ དུས་ ར་ དེ་ ནི་ ང འི་ ཨ་མ་ དང་ ཁྱད་མེད་ ཡིན་ ཞེས་ གསུངས་པ ར་ ཐོས །ནང་ དུ་ སྐྱེས་པ འི་ མེ་ཏོག་ སྔོན་པོ་ དེ་ རིན་པོ་ཆེ་ མཆོག་ གི་ ཨ་ཕྱི་ སྐལ་བཟང་ སྒྲོལ་མ ས་ མི་ ཀུན་ ལ་ མཇལ་ བཅུག་ དུས་ ངོ་མཚར་ དཔག་མེད་ སྐྱེས །ཡུལ་མི་ རྣམས་ ཀྱིས་ འཇའ་ དང་ འོད་ ཀྱི་ གུར་ ཕུབ་པ་ མཐོང་ ནས་ གོང་མ་པ འི་ བུ་ དེ་ སྐྱེ་བ་ མཐོན་པོ་ ཞིག་ ཡིན་ སྲིད །ཨ་མ་ འདས་པ ས་ བསོད་ནམས་ ཆུང་བ་ ཞིག་ ཀྱང་ ཡིན་པ ས་ གང་ཡིན་ སྨྲ་ མི་ ཐུབ་པ་ སོགས་ ཟེར་ རོ །། གཉེན་ དྲུང་ རྣམས་ ཀྱིས་ ཞོ་ དང་ འོ་མ་ སོགས་ ཨ་ཕྱི་ སྐལ་བཟང་ སྒྲོལ་མ་ དང་ ཨ་ནེ་ ཚེ་རིང་ གཡང་ འཛོམས་ གཉིས་ ཀྱི་ ལག་ ཏུ་ ཕུལ་ ནས་ བུ་ ལ་ གཙང་སྦྲ་ བྱེད་ དགོས་ ཞེས་ སྨྲ ས །སྐུ་ འཁྲུངས་པ་ དང་ ནོར་ ལོངས་སྤྱོད་ ཀྱང་ སྔར་ ལ ས་ ལྷག་པར་ འཕེལ་ ནས་ སྐྱིད་པ ར་ བྱུང་ །དགུང་ལོ་ གཉིས་ ཙམ་ ལ་ ཁང་པ འི་ འགྲམ་ དུ་ཡོད་པ འི་ རྡོ་བ འི་ སྟེང་ ཞབས་ གཡོན་མ འི་ ཞབས་རྗེས་ བྱུང་བ ས་ ད་ལྟ་ ཡང་ མཇལ་ རྒྱུ་ ཡོད་པ་ ནི་ བླ་མ་ རྟོགས་པ་ དང་ ལྡན་པ་ གང་ གི་ སྐུ་ འཁྲུངས་པ འི་ མཛད་པ འོ །_།སྤྲུལ་སྐུ ར་ ངོས་འཛིན་ མཛད་ ཚུལ །རྟོགས་ལྡན་ རིན་པོ་ཆེ་ སྐུ་ཕྲེང་ བརྒྱད་པ་ དགོངས་པ་ རྫོགས་ ནས་ ཡང་སྲིད་ མ་ འཁྲུངས་ བར་ དུ་ ཆོས་སྐུ་ རིན་པོ་ཆེ་ སྒྲུབ་བརྒྱུད་ བསྟན་པ འི་ ཉི་མ་ ཆོས་རྗེ ར་ བསྐོ་ བཞག་ མཛད་ ནས་ ལ་ ལོག་ ཡུལ་ཚོ་ རྣམས་ ལ་ བྱིན་ བརླབས་ སུ་ ཕེབས་ སྐབས་ རྡོ་ ཁུལ་ དུ་ བཞུགས་ ནས་སྔ་དྲོ་ ཞིག་ དགེ་རྒན་ ལ །_ རྨི་ལམ་ བཟང་པོ་ གཟིགས་ཚུལ་ གསུངས་ ནས་ གོང་མ་ཚང་ གི་ བུ་ དེ་ ང འི་ མདུན་ དུ་ ཁྲིད་ ཤོག་ ངས་ འཁྲུས་ ཤིག་ འབུལ་ རྒྱུ་ ཡིན་ གསུངས་པ་ དང་ཨ་ནེ་ ཚེ་རིང་ གཡང་ འཛོམས་ ནས་ བུ་ཆུང་ དེ་ རྒྱབ་ ཏུ་ ཁུར་ ཏེ་ ཆོས་སྐུ་ རིན་པོ་ཆེ་ མཇལ་ དུས་ཡུན་ རིང་ བུ་ དེ་ ལ་ གཟིགས་ ནས་ གཙང་སྦྲ་ བྱ་ དགོས་ ཚུལ་ སོགས་ གསུངས །བུ་ དེ་ རྟོགས་ལྡན་ གྱི་ ཡང་སྲིད་ འཁྲུལ་ མེད་ ཡིན་པ ས་ རྟེན་འབྲེལ་ དུ་ འབྲི་གུང་ དང་པོ འི་ བླ་མ འི་ མཚན་ ནས་ བགྲངས་ ཏེ་ མཚན་ ཚུལ་ཁྲིམས་ རྒྱ་མཚོ་ ཞེས་ གནང །དེ་ནས་ རིང་པོ ར་ མ་ ལོན་པ ར་ ༸སྐྱབས་ རྗེ་ རྒྱལ་སྲས་ བ་ཀུ་ལ་ རིན་པོ་ཆེ་ ཐུབ་བསྟན་ མཆོག་ ནོར་ གྱི་ དྲུང་ དུ་ གཙུག་ཕུད་ ཕུལ་ རྗེས་ མཚན་ཐུབ་ བསྟན་ བསྟན་པ འི་ 